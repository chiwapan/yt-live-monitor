# Views collector — batch รายวัน (Analytics API, OAuth)
FROM python:3.11-slim

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app
ENV TZ=Asia/Bangkok \
    VIEWS_JSONL=/data/views_data.jsonl \
    GAPI_SCRIPT=/app/google_api.py

CMD ["python", "yt-views-collector.py"]
